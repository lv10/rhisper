# rhisper configuration
# Copy to ~/.config/rhisper/rhisperrc and customize
# When in doubt, check by running 'rhisper --log'

# Transcription Provider:
# provider: "groq" (default), "openai", or "custom".
#   groq   : reads GROQ_API_KEY, uses Groq's Whisper endpoint.
#   openai : reads OPENAI_API_KEY, uses OpenAI's /audio/transcriptions endpoint.
#   custom : reads RHISPER_API_KEY, sends requests to api-base-url below.
provider     : "groq"
api-base-url : ""
# model: overrides the provider's default model selection (e.g. "whisper-1",
# "gpt-4o-transcribe"). Empty = provider default (Groq picks large/turbo
# automatically based on long-recording-threshold below).
model        : ""

# Transcription Settings:
long-recording-threshold : 1000
transcription-prompt     : ""
# language: ISO-639-1 code (e.g., de, en, fr). Empty = auto-detect.
language                 : ""

# paste-mode: "type" (layout-sensitive, keeps clipboard),
#             "clipboard" (always paste via clipboard, overwrites clipboard), or
#             "clipboard-restore" (like clipboard, but saves and restores previous clipboard content)
paste-mode               : "type"

# Paste Timing (seconds):
non-ascii-initial-delay : 0.15 # Increase this if first character comes out wrong.
non-ascii-default-delay : 0.025

# Keyboard Layout (Linux only):
# Layout used when typing ASCII characters (us | dk | es).
# The daemon is restarted automatically when this changes.
# Ignored on macOS, which types via direct Unicode injection regardless of
# the active keyboard layout.
keyboard-layout : us

# Audio Input:
# audio-device: explicit capture source. Empty = the system default input,
# which is what rhisper has always used. Handy when several microphones are
# connected and the system default is not the one you dictate into.
#   Linux : a PipeWire target - node name (e.g. "alsa_input.usb-Blue_Microphones-00.analog-stereo")
#           or numeric node id. Run 'rhisper --list-devices' to see them.
#   macOS : a CoreAudio device name, passed to sox via AUDIODEV.
audio-device : ""
# audio-device-fallback: what to do when audio-device is set but that
# device is not currently present (unplugged, headset off).
#   yes (default) : record from the system default instead, noted in the log.
#   no            : refuse to record and say so, rather than capturing the
#                   wrong microphone.
# Worth knowing: pw-record does not fail on an unknown target - PipeWire
# quietly links the stream to the default source - so without this check
# a missing microphone looks exactly like a working one.
# Linux only: macOS cannot enumerate devices here, so the setting is ignored.
audio-device-fallback : yes

# Status Placeholders:
# placeholders: how rhisper reports "recording" / "transcribing" / "no sound".
#   auto   : (default) notify when paste-mode is a clipboard one and
#            notify-send exists, inline otherwise.
#   inline : type the status into the target field and delete it again.
#   notify : show a desktop notification (needs notify-send; gdbus dismisses it).
#   off    : no status feedback at all.
# Inline placeholders briefly write into whatever you are editing and are
# removed by sending one backspace per character - which misfires when the
# field autocompletes or reformats. Notifications avoid that entirely.
# macOS has no notify-send, so 'auto' resolves to inline there.
placeholders             : "auto"
placeholder-recording    : "(recording...)"
placeholder-transcribing : "(transcribing...)"
placeholder-silent       : "(no sound detected)"

# Silence Detection:
silence-threshold  : -50
# min-speech-seconds: minimum contiguous stretch of audio above
# silence-threshold required anywhere in the recording to consider it real
# speech. This is deliberately an absolute duration, not a percentage of
# the whole recording - how long you pause before or after speaking has no
# bearing on whether you said something.
min-speech-seconds : 0.3

