# Grants the active logind session access to /dev/uinput without requiring
# the user to be added to the "input" group and re-login. Installed by all
# rhisper packages to /usr/lib/udev/rules.d/60-rhisper-uinput.rules.
#
# `usermod -aG input $USER` (documented in the README as a manual fallback)
# remains necessary on systems without a udev-tag-aware session manager
# (e.g. no logind, or a minimal init without udev running).
KERNEL=="uinput", MODE="0660", GROUP="input", TAG+="uaccess"
